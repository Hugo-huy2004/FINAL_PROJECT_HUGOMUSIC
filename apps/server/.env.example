# Copy to .env and fill in. Nothing here is a real credential.

PORT=5001
MONGO_URI=mongodb://localhost:27017/hugo-music
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Shared state for every instance behind the load balancer (OTP, guest quota, rate limit, cache).
REDIS_URL=redis://127.0.0.1:6379

# Behind the load balancer (lb/cluster.js sets these per process): api | realtime | all (dev).
ROLE=all
# INSTANCE_ID=api-5011
# Trust X-Forwarded-For from the load balancer on the same machine.
TRUST_PROXY=loopback
# Requests per minute per IP across /api (default 600); raise for load tests from one machine
API_RATE_LIMIT=600

# Seeded admin account (backend/scripts/admin/createAdmin.js) — the one plaintext-password
# bypass in authController.js checks against this instead of a bcrypt hash.
ADMIN_PASSWORD=

# Google sign-in (server-side redirect flow). Authorized redirect URI in Google Cloud Console:
# <PUBLIC_API_URL>/api/auth/google/callback (locally http://localhost:5001/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public https URL of the API (required for Google sign-in on phones — Google rejects LAN IPs).
PUBLIC_API_URL=
# Deployed web app origin allowed as a post-login redirect target.
WEB_APP_URL=

# Admin login 2FA — OTP is sent to this bot, to whichever chat scripts/admin/linkTelegram.js linked.
TELEGRAM_BOT_TOKEN=

# Email OTP for the registration wizard (utils/email.js). Left unset, OTPs just log
# to the server console instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Hugo Music <no-reply@hugomusic.app>

# Cloudflare R2 (S3-compatible) — song audio, cover art, avatars, HLS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hugomusic
# Base stored in Song.filePath/hlsPath. It is the private S3 endpoint, not a public
# URL: listeners always go through the Worker (worker/), never hit this directly.
R2_PUBLIC_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/hugomusic

# PSL (docs/PSL_TECHNIQUE.md): Python with visqol-python, used when an approved song
# is measured before HLS build. Leave empty to use backend/.venv/bin/python:
#   python3 -m venv .venv && .venv/bin/pip install visqol-python
PSL_PYTHON=

# Multi-CDN (utils/cdnSources.js): order = initial priority; clients re-rank by measured latency.
CDN_URLS=cloudflare=https://<worker-or-custom-domain>
# Add ,bunny=https://<zone>.b-cdn.net above and set the pull zone's Token Authentication key here.
BUNNY_TOKEN_KEY=
