.env*
*.env
!.env.example

# Media & audio files (Cloudflare R2 is used instead of repository storage)
*.zip
apps/server/seed_audio/
apps/server/seed_audio/*
apps/server/seed_audio_*/

# Build and caches
.expo/
dist/
web-build/
*.log
.DS_Store

# Tooling caches
.wrangler/
.report-build/

# Tài liệu và bản nháp báo cáo: không đưa lên repo
docs/

# Generated at publish time (hugo-stream)
packages/stream/types/

# Local shortcuts to apps/* and packages/client (symlinks for the editor), not part of the repo
/backend
/mobile
/shared
/web
